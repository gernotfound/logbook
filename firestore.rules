rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function deletionJobExists(userId) {
      return exists(/databases/$(database)/documents/account_deletions/$(userId));
    }

    // Only the trusted backend may set this per-UID revocation barrier.
    // Existing Firebase ID tokens can remain cryptographically valid for up
    // to an hour; auth_time fences them immediately at the Firestore boundary.
    function hasCurrentSession(userId) {
      let record = /databases/$(database)/documents/session_revocations/$(userId);
      return !exists(record) || (
        get(record).data.revokedAfterSeconds is int
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time > get(record).data.revokedAfterSeconds
      );
    }

    function isActiveOwner(userId) {
      return isOwner(userId)
        && request.auth.token.email_verified == true
        && !deletionJobExists(userId)
        && hasCurrentSession(userId);
    }

    // A server-owned proof that is malformed must not authorize direct client
    // access even when the trusted API correctly rejects the same record.
    function isValidActiveConsentProof(data, userId) {
      return data.keys().hasAll(['status', 'revision', 'uid', 'acceptedAt', 'privacyVersion', 'termsVersion'])
        && data.status == 'active'
        && data.revision is int
        && data.revision >= 1
        && data.uid == userId
        && data.acceptedAt is string
        && data.acceptedAt.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$')
        && data.privacyVersion is string
        && data.privacyVersion.size() > 0
        && data.termsVersion is string
        && data.termsVersion.size() > 0;
    }

    // Keep the trusted document read on the existing cached path: multi-doc
    // Protocol 3 transactions operate near the Rules expression budget.
    function consentWithdrawn(userId) {
      let record = /databases/$(database)/documents/health_consent_withdrawals/$(userId);
      return !exists(record) || !isValidActiveConsentProof(get(record).data, userId);
    }

    // A revoked consent record is permanent across reacceptance cycles.
    // Clients from an older generation can neither renew a replica nor publish
    // their old queued journal after the user has explicitly reaccepted.
    function matchesConsentEpoch(userId, candidate) {
      let record = /databases/$(database)/documents/health_consent_withdrawals/$(userId);
      return exists(record) && (
        get(record).data.status == 'active'
        && 'consentRevision' in candidate
        && candidate.consentRevision is int
        && candidate.consentRevision == get(record).data.revision
      );
    }

    function isWritableOwner(userId) {
      return isActiveOwner(userId) && !consentWithdrawn(userId);
    }

    function isValidMonthId(monthId) {
      return monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    // No plaintext business values or causal candidates may leave the browser.
    function isSealedCloudDocument(data) {
      return data is map
        && data.keys().hasOnly(['_schemaVersion', '_sync', '_sealed'])
        && data.keys().hasAll(['_schemaVersion', '_sync', '_sealed'])
        && data._sealed is map
        && data._sealed.keys().hasOnly(['format', 'version', 'nonce', 'ciphertext'])
        && data._sealed.keys().hasAll(['format', 'version', 'nonce', 'ciphertext'])
        && data._sealed.format == 'thelogbook-cloud-document'
        && data._sealed.version == 1
        && data._sealed.nonce is string
        && data._sealed.nonce.matches('^[A-Za-z0-9_-]{32}$')
        && data._sealed.ciphertext is string
        && data._sealed.ciphertext.size() >= 22
        && data._sync is map
        && data._sync.fields is map
        && data._sync.fields.keys().size() == 0;
    }

    function incomingData() {
      return request.resource.data;
    }

    function isValidDataSchema(docData) {
      return '_schemaVersion' in docData && docData._schemaVersion == 1;
    }

    function preservesDataSchema() {
      return resource == null
        || (
          '_schemaVersion' in resource.data
          && incomingData()._schemaVersion >= resource.data._schemaVersion
        );
    }

    // Security Rules enforce the persisted protocol envelope and the replica-fencing
    // boundary. Field-level causal validation remains the TypeScript source of truth.
    function isReplicaSlot(slot) {
      return slot is string && slot.matches('^s(0[0-9]|1[0-5])$');
    }

    function isValidReplicaWriter(writer) {
      return writer is map
        && writer.keys().hasOnly(['slot', 'replicaId', 'generation', 'seq', 'consentRevision'])
        && isReplicaSlot(writer.slot)
        && writer.replicaId is string
        && writer.replicaId.size() > 0
        && writer.replicaId.size() <= 128
        && writer.generation is int
        && writer.generation >= 1
        && writer.generation <= 9007199254740991
        && writer.seq is int
        && writer.seq >= 0
        && writer.seq <= 9007199254740991
        && (!('consentRevision' in writer)
            || (writer.consentRevision is int && writer.consentRevision >= 0));
    }

    function isValidSync(docData) {
      return '_sync' in docData
        && docData._sync is map
        && docData._sync.protocolVersion == 3
        && docData._sync.clock is map
        // Rules have a strict expression budget. Validate canonical actor names
        // and the active writer's coordinate here; the TypeScript parser validates
        // every clock coordinate before hydration/replay.
        && docData._sync.clock.keys().hasOnly(['s00', 's01', 's02', 's03', 's04', 's05', 's06', 's07', 's08', 's09', 's10', 's11', 's12', 's13', 's14', 's15'])
        && isValidCheckpointCoordinate(docData._sync.clock, docData._sync.writer.slot)
        && docData._sync.fields is map
        && docData._sync.keys().hasOnly(['protocolVersion', 'clock', 'fields', 'writer'])
        && 'writer' in docData._sync
        && isValidReplicaWriter(docData._sync.writer);
    }

    function preservesSyncProtocol() {
      return resource == null
        || (
          '_sync' in resource.data
          && incomingData()._sync.protocolVersion >= resource.data._sync.protocolVersion
        );
    }

    function hasProtocol3Writer(userId, docData) {
      let writer = docData._sync.writer;
      let control = getAfter(/databases/$(database)/documents/users/$(userId)/sync_control/state).data;
      return docData._sync.protocolVersion == 3
        && control.protocolVersion == 3
        && control.mutation is map
        && control.mutation.action == 'advance'
        && control.mutation.slot == writer.slot
        // A prior advance does not authorize a new write. The nonce must
        // change in the same atomic request as the business document.
        && control.mutation.batchId != get(/databases/$(database)/documents/users/$(userId)/sync_control/state).data.mutation.get('batchId', '')
        // Control carries the trusted epoch; checking the writer against it
        // avoids duplicate consent lookups in Protocol 3 business writes.
        && matchesConsentEpoch(userId, control)
        && writer.consentRevision is int
        && writer.consentRevision == control.consentRevision
        && writer.slot in control.replicas
        && control.replicas[writer.slot].status == 'active'
        && control.replicas[writer.slot].replicaId == writer.replicaId
        && control.replicas[writer.slot].generation == writer.generation
        && control.replicas[writer.slot].lastSeq >= writer.seq
        && control.replicas[writer.slot].leaseUntilMs >= request.time.toMillis();
    }

    function isAuthorizedSyncWrite(userId, docData) {
      // First-account baseline: every persisted business write is Protocol 3 and
      // fenced to an active replica. There is no pre-control/unsynced write path.
      return '_sync' in docData && hasProtocol3Writer(userId, docData);
    }

    // Checkpoints affect terminal-tombstone GC; their coordinates must be valid
    // Protocol 3 actor sequences, not arbitrary client-defined map entries.
    function isValidCheckpointCoordinate(clock, slot) {
      let seq = clock.get(slot, 0);
      return seq is int && seq >= 0 && seq <= 9007199254740991;
    }

    // A checkpoint normally has 0-2 actors. Validate those present actors
    // directly to keep Protocol 3 batches under the Firestore expression limit;
    // the exhaustive fallback preserves the 16-slot bound for larger clocks.
    function isValidCheckpointClock(clock) {
      return clock is map
        && clock.keys().hasOnly(['s00', 's01', 's02', 's03', 's04', 's05', 's06', 's07', 's08', 's09', 's10', 's11', 's12', 's13', 's14', 's15'])
        && (
          clock.size() == 0
          || (clock.size() == 1 && isValidCheckpointCoordinate(clock, clock.keys()[0]))
          || (clock.size() == 2
            && isValidCheckpointCoordinate(clock, clock.keys()[0])
            && isValidCheckpointCoordinate(clock, clock.keys()[1]))
          || (
            isValidCheckpointCoordinate(clock, 's00')
            && isValidCheckpointCoordinate(clock, 's01')
            && isValidCheckpointCoordinate(clock, 's02')
            && isValidCheckpointCoordinate(clock, 's03')
            && isValidCheckpointCoordinate(clock, 's04')
            && isValidCheckpointCoordinate(clock, 's05')
            && isValidCheckpointCoordinate(clock, 's06')
            && isValidCheckpointCoordinate(clock, 's07')
            && isValidCheckpointCoordinate(clock, 's08')
            && isValidCheckpointCoordinate(clock, 's09')
            && isValidCheckpointCoordinate(clock, 's10')
            && isValidCheckpointCoordinate(clock, 's11')
            && isValidCheckpointCoordinate(clock, 's12')
            && isValidCheckpointCoordinate(clock, 's13')
            && isValidCheckpointCoordinate(clock, 's14')
            && isValidCheckpointCoordinate(clock, 's15')
          )
        );
    }

    function isValidReplicaEntry(entry) {
      return entry is map
        && entry.keys().hasOnly([
          'replicaId',
          'generation',
          'status',
          'lastSeq',
          'leaseUntilMs',
          'checkpointAtMs',
          'checkpointClock'
        ])
        && entry.replicaId is string
        && entry.replicaId.size() > 0
        && entry.replicaId.size() <= 128
        && entry.generation is int
        && entry.generation >= 1
        && entry.generation <= 9007199254740991
        && (entry.status == 'active' || entry.status == 'retired')
        && entry.lastSeq is int
        && entry.lastSeq >= 0
        && entry.lastSeq <= 9007199254740991
        && entry.leaseUntilMs is int
        && entry.leaseUntilMs >= 1
        && entry.checkpointAtMs is int
        && entry.checkpointAtMs >= 1
        && isValidCheckpointClock(entry.checkpointClock);
    }

    function isFreshReplicaLease(entry) {
      return entry.status == 'active'
        && entry.checkpointAtMs <= request.time.toMillis() + 600000
        && entry.checkpointAtMs >= request.time.toMillis() - 600000
        && entry.leaseUntilMs > request.time.toMillis()
        && entry.leaseUntilMs <= request.time.toMillis() + 31968000000;
    }

    function hasValidReplicaControlShape(data) {
      return data is map
        && data.keys().hasOnly(['protocolVersion', 'replicas', 'mutation', 'consentRevision'])
        && (!('consentRevision' in data)
            || (data.consentRevision is int && data.consentRevision >= 0))
        && data.protocolVersion == 3
        && data.replicas is map
        && data.replicas.size() <= 16
        && data.replicas.keys().hasOnly([
          's00','s01','s02','s03','s04','s05','s06','s07',
          's08','s09','s10','s11','s12','s13','s14','s15'
        ])
        && data.mutation is map
        && data.mutation.keys().hasOnly(['slot', 'action', 'batchId'])
        && (data.mutation.action == 'advance'
          ? ('batchId' in data.mutation
            && data.mutation.batchId is string
            && data.mutation.batchId.size() >= 16
            && data.mutation.batchId.size() <= 128)
          : !('batchId' in data.mutation))
        && isReplicaSlot(data.mutation.slot)
        && (
          data.mutation.action == 'register'
          || data.mutation.action == 'checkpoint'
          || data.mutation.action == 'advance'
          || data.mutation.action == 'retire'
          || data.mutation.action == 'reuse-expired'
        )
        && data.mutation.slot in data.replicas
        && isValidReplicaEntry(data.replicas[data.mutation.slot]);
    }

    function validReplicaControlCreate(userId, data) {
      let slot = data.mutation.slot;
      let entry = data.replicas[slot];
      return hasValidReplicaControlShape(data)
        && matchesConsentEpoch(userId, data)
        && data.mutation.action == 'register'
        && data.replicas.size() == 1
        && entry.generation == 1
        && isFreshReplicaLease(entry);
    }

    function validReplicaControlUpdate(userId, oldData, newData) {
      let slot = newData.mutation.slot;
      let next = newData.replicas[slot];
      let existed = slot in oldData.replicas;
      return hasValidReplicaControlShape(newData)
        && matchesConsentEpoch(userId, newData)
        && newData.diff(oldData).affectedKeys().hasOnly(['replicas', 'mutation', 'consentRevision'])
        && newData.replicas.diff(oldData.replicas).affectedKeys().hasOnly([slot])
        && (
          (
            existed
            && newData.mutation.action == 'reuse-expired'
            && (
              oldData.replicas[slot].status == 'retired'
              || oldData.replicas[slot].leaseUntilMs < request.time.toMillis()
            )
            && next.status == 'active'
            && next.replicaId != oldData.replicas[slot].replicaId
            && next.generation == oldData.replicas[slot].generation + 1
            && next.lastSeq >= oldData.replicas[slot].lastSeq
            && isFreshReplicaLease(next)
          )
          || (
            newData.mutation.action == 'register'
            && !existed
            && next.generation == 1
            && isFreshReplicaLease(next)
          )
          || (
            existed
            && newData.mutation.action == 'checkpoint'
            && oldData.replicas[slot].status == 'active'
            && oldData.replicas[slot].leaseUntilMs >= request.time.toMillis()
            && next.status == 'active'
            && next.replicaId == oldData.replicas[slot].replicaId
            && next.generation == oldData.replicas[slot].generation
            && next.lastSeq >= oldData.replicas[slot].lastSeq
            && isFreshReplicaLease(next)
          )
          || (
            existed
            && newData.mutation.action == 'advance'
            && oldData.replicas[slot].status == 'active'
            && oldData.replicas[slot].leaseUntilMs >= request.time.toMillis()
            && newData.mutation.batchId != oldData.mutation.get('batchId', '')
            && next.diff(oldData.replicas[slot]).affectedKeys().hasOnly(['lastSeq'])
            && next.lastSeq >= oldData.replicas[slot].lastSeq
          )
          || (
            existed
            && newData.mutation.action == 'retire'
            && oldData.replicas[slot].status == 'active'
            && oldData.replicas[slot].leaseUntilMs < request.time.toMillis()
            && next.diff(oldData.replicas[slot]).affectedKeys().hasOnly(['status'])
            && next.status == 'retired'
          )
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Public catalog clients request known manifest/version documents by ID.
    // Queries would expose arbitrary historical documents and amplify quota abuse;
    // nested catalog paths are not part of the publication contract.
    match /global_catalog/{documentId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Server-only administrative barrier. Clients cannot inspect or mutate deletion jobs;
    // the trusted Admin SDK creates them and bypasses Firestore Security Rules.
    match /health_consent_withdrawals/{userId} {
      allow read, write: if false;
    }

    match /account_deletions/{userId} {
      allow read, write: if false;
    }

    // Only the verified backend may register authenticated online activity.
    match /account_activity/{userId} {
      allow read, write: if false;
    }

    match /session_revocations/{userId} {
      allow read, write: if false;
    }

    // The wrapped Account Data Key belongs only to the trusted Vercel Admin
    // boundary. An authenticated Firestore client must never read or replace
    // it, even when it owns users/{userId} and has active health consent.
    match /user_data_keys/{userId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Root deletion is server-only. Client-side account deletion must always use
      // the trusted account-deletion job so subcollections and Firebase Auth cannot
      // be orphaned.
      allow read: if isWritableOwner(userId);

      allow create, update: if isWritableOwner(userId)
        && isSealedCloudDocument(incomingData())
        && isValidDataSchema(incomingData())
        && preservesDataSchema()
        && isValidSync(incomingData())
        && isAuthorizedSyncWrite(userId, incomingData())
        && preservesSyncProtocol();

      match /history_months/{monthId} {
        allow read: if isWritableOwner(userId);
        allow delete: if false;
        allow create, update: if isWritableOwner(userId)
          && isValidMonthId(monthId)
          && incomingData() is map
          && isSealedCloudDocument(incomingData())
          && isValidDataSchema(incomingData())
          && preservesDataSchema()
          && isValidSync(incomingData())
          && isAuthorizedSyncWrite(userId, incomingData())
          && preservesSyncProtocol();
      }

      match /nutrition_months/{monthId} {
        allow read: if isWritableOwner(userId);
        allow delete: if false;
        allow create, update: if isWritableOwner(userId)
          && isValidMonthId(monthId)
          && incomingData() is map
          && isSealedCloudDocument(incomingData())
          && isValidDataSchema(incomingData())
          && preservesDataSchema()
          && isValidSync(incomingData())
          && isAuthorizedSyncWrite(userId, incomingData())
          && preservesSyncProtocol();
      }

      match /sync_control/{controlId} {
        allow read: if controlId == 'state' && isWritableOwner(userId);
        allow create: if controlId == 'state'
          && isWritableOwner(userId)
          && validReplicaControlCreate(userId, incomingData());
        allow update: if controlId == 'state'
          && isWritableOwner(userId)
          && validReplicaControlUpdate(userId, resource.data, incomingData());
        allow delete: if false;
      }

    }
  }
}
