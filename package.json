{
  "name": "logbook",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "analyze": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "npm run test:unit && npm run test:integration",
    "test:stress": "vitest run \"tests/**/*adversarial*.test.{ts,tsx}\" \"tests/**/*stress*.test.{ts,tsx}\" \"tests/**/challenger_*.test.{ts,tsx}\"",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run tests/"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "fast-deep-equal": "^3.1.3",
    "firebase": "^12.17.0",
    "fuse.js": "^7.5.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.10",
    "firebase-admin": "^14.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.76.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
