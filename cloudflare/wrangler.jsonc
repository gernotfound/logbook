{
  "name": "thelogbook-frontend",
  "main": "./auth-proxy.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/__/auth",
      "/__/auth/*"
    ]
  },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "thelogbook.me",
      "custom_domain": true
    }
  ]
}
