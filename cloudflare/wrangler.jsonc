{
  "name": "thelogbook-frontend",
  "main": "./auth-proxy.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/__/auth",
      "/__/auth/*",
      "/api/auth/kinde/start",
      "/api/auth/kinde/callback",
      "/api/auth/session",
      "/api/auth/logout"
    ]
  },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "thelogbook.me",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "KINDE_HTTP",
      "service": "thelogbook-cf03-kinde-http-isolated"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://thelogbook.me"
  }
}
