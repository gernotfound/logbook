{
  "name": "thelogbook-frontend",
  "main": "./auth-proxy.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/__/auth/*"
    ]
  }
}
