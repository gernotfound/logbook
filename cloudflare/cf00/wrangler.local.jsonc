{
  "name": "thelogbook-cf00-local-only",
  "main": "./probe-worker.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cf00-local-only",
    "database_id": "00000000-0000-4000-8000-000000000001"
  }],
  "durable_objects": {
    "bindings": [{ "name": "PASSWORD_PROBE", "class_name": "PasswordProbe" }]
  },
  "migrations": [{ "tag": "cf00-v1", "new_sqlite_classes": ["PasswordProbe"] }]
}
