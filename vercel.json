{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "functions": {
    "api/account-deletion.ts": {
      "maxDuration": 300
    },
    "api/account-deletion-cron.ts": {
      "maxDuration": 300
    },
    "api/account-deletion-device.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/account-deletion-cron",
      "schedule": "0 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://thelogbook.web.app/",
      "permanent": false
    }
  ]
}
