{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "functions": {
    "api/account-deletion.ts": {
      "maxDuration": 300
    },
    "api/account-deletion-cron.ts": {
      "maxDuration": 300
    },
    "api/account-deletion-device.ts": {
      "maxDuration": 30
    },
    "api/legacy-service-worker.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/account-deletion-cron",
      "schedule": "0 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://thelogbook.web.app/",
      "statusCode": 301
    }
  ],
  "fluid": true,
  "framework": null,
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "rewrites": [
    {
      "source": "/sw.js",
      "destination": "/api/legacy-service-worker"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
