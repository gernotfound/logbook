# Firebase Web client configuration — public runtime configuration, not Admin secrets.
# Frontend Production is built by GitHub Actions for Firebase Hosting, NOT by Vercel.
# Production VITE_* values come from GitHub Actions variables; this file is only a template.
VITE_FIREBASE_API_KEY=your_api_key_here
# Production authDomain must match the Firebase Hosting origin (enforced by the deploy workflow).
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
# Required for trusted backend requests; no implicit production fallback.
VITE_ACCOUNT_DELETION_API_ORIGIN=https://logbook-gnf.vercel.app

# Firebase App Check — reCAPTCHA Enterprise public site key (Firebase Hosting frontend build).
# Required for Production Hosting; when absent locally, App Check cannot initialize.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key_here

# Vercel Functions / trusted server runtime for account lifecycle, consent and cloud keys.
# These values are SERVER-ONLY: never prefix them with VITE_ and never commit real credentials.
FIREBASE_ADMIN_PROJECT_ID=your_server_project_id_here
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_client_email_here
FIREBASE_ADMIN_PRIVATE_KEY="your_escaped_private_key_here"
PUBLIC_APP_ORIGIN=https://thelogbook.web.app
# Required by the current encrypted-cloud key boundary (not by local/offline startup): server-only
# 32-byte AES-GCM wrapping key (BASE64 of 32 cryptographically random bytes).
# Generate outside source control and provision in the existing Vercel environment.
# NEVER commit, log, send to the browser or derive it from Firebase Admin secrets.
# CLOUD_ACCOUNT_KEK_V1=<base64-of-32-random-bytes>
# IMPORTANT: retain a separately protected operator backup of this EXACT value.
# If lost/replaced, every account key wrapped under v1 becomes irrecoverable.
# No Cloud KMS, paid Google Cloud project or Firebase Blaze upgrade is needed.
# Account inactivity rollout: intentionally disabled until privacy review, end-to-end
# validation and explicit operational activation. The client flag is baked into
# Firebase Hosting at build time, whereas backend flags live only on Vercel.
# VITE_ACCOUNT_INACTIVITY_TRACKING=true  # Firebase Hosting build env, not Vercel
# ACCOUNT_INACTIVITY_TRACKING_ENABLED=true  # Vercel only, server receipt of visible use
# ACCOUNT_INACTIVITY_DELETION_ENABLED=true  # Vercel only, irreversible cron scheduling
# Do not enable deletion if activity tracking is disabled: all three switches
# must be coordinated and newly collected activity must be aged twelve months.
# Authenticates the scheduled account-deletion recovery/retention cron.
CRON_SECRET=generate_a_long_random_secret_here
