# Canonical Production origin served by Firebase Hosting.
VITE_PUBLIC_ORIGIN=https://your-logbook-site.web.app

# Direct Cloud Functions v2 HTTPS endpoint. Hosting rewrites are intentionally
# not used for account deletion because the workflow can exceed Hosting's proxy timeout.
VITE_ACCOUNT_DELETION_API_URL=https://your-region-your-project.cloudfunctions.net/accountDeletion

# Firebase Web client configuration actually used by LogBook.
# These identifiers are public runtime configuration, not Admin secrets.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-logbook-site.web.app
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_FUNCTION_REGION=europe-west1
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=G-your_measurement_id_here

# Firebase App Check — reCAPTCHA Enterprise public site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key_here

# Firebase Functions non-secret deployment parameters.
LOGBOOK_FUNCTION_REGION=europe-west1
LOGBOOK_FUNCTION_SERVICE_ACCOUNT=logbook-runtime@your-project.iam.gserviceaccount.com
LOGBOOK_ALLOWED_ORIGINS=https://your-logbook-site.web.app

# Sentry client error monitoring — public DSN embedded in the production browser bundle.
VITE_SENTRY_DSN=your_sentry_public_dsn_here

# Sentry source-map upload — build-time only. SENTRY_AUTH_TOKEN is a secret.
SENTRY_AUTH_TOKEN=your_sentry_org_ci_token_here
SENTRY_ORG=your_sentry_org_slug_here
SENTRY_PROJECT=your_sentry_project_slug_here
