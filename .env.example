# Local development template: placeholders only. Production values belong to the providers.
# The public frontend is built for Cloudflare Workers Static Assets. The repository records
# Firebase Hosting as disabled and the legacy Vercel backend as suspended; this file
# does not attest their live status or authorize reactivation.
#
# Firebase client configuration remains necessary for imported legacy modules during
# migration. Cloudflare CI supplies its public VITE_* values separately and derives
# VITE_FIREBASE_AUTH_DOMAIN from CLOUDFLARE_APP_ORIGIN (an exact HTTPS origin).
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Legacy trusted Vercel API only. Empty means local callers fail closed instead of
# accidentally contacting the suspended backend. Cloudflare CI has a separate
# transitional, explicitly configured value until these callers are replaced.
VITE_ACCOUNT_DELETION_API_ORIGIN=

# Legacy Firebase App Check public site key; absence prevents its protected cloud
# operations from initializing. It is not used to authenticate with Kinde.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key_here

# Server-only variables for the suspended Vercel implementation still in this repository.
# Never prefix them with VITE_, commit real credentials or treat them as Cloudflare
# Worker bindings. These placeholders do not activate the backend.
FIREBASE_ADMIN_PROJECT_ID=your_server_project_id_here
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_client_email_here
FIREBASE_ADMIN_PRIVATE_KEY="your_escaped_private_key_here"
PUBLIC_APP_ORIGIN=https://thelogbook.me
# Optional legacy candidate origin for isolated Vercel API tests; leave unset.
# PUBLIC_CANDIDATE_APP_ORIGIN=https://example.invalid

# CLOUD_ACCOUNT_KEK_V1 is a server-only wrapping secret, not a client variable.
# The isolated Cloudflare API Worker uses its own provider-managed secret binding.
# Never store its value here, in GitHub variables or in a frontend build.
# Preserve independent, protected recovery material; provisioning is not proof of restore.
# CLOUD_ACCOUNT_KEK_V1=<base64-of-32-random-bytes>

# Legacy inactivity tracking/deletion switches remain disabled. Do not enable them
# on the suspended backend or infer a Cloudflare implementation from their presence.
# VITE_ACCOUNT_INACTIVITY_TRACKING=true          # Legacy frontend build flag
# ACCOUNT_INACTIVITY_TRACKING_ENABLED=true       # Legacy server activity recording
# ACCOUNT_INACTIVITY_DELETION_ENABLED=true       # Legacy irreversible cron scheduling

# Legacy Vercel scheduled job authentication; not a Cloudflare Worker secret.
CRON_SECRET=generate_a_long_random_secret_here
