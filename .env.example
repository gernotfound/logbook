# Canonical Production origin served by Firebase Hosting.
VITE_PUBLIC_ORIGIN=https://your-logbook-site.web.app

# During the origin migration window, the new Firebase build reads from the
# previous Vercel origin through an explicit user-initiated popup bridge.
VITE_ORIGIN_MIGRATION_SOURCE=https://your-legacy-logbook.vercel.app
VITE_ORIGIN_MIGRATION_TARGET=https://your-logbook-site.web.app

# Direct Cloud Functions v2 HTTPS endpoint. Hosting rewrites are intentionally
# not used for account deletion because the workflow can exceed Hosting's proxy timeout.
VITE_ACCOUNT_DELETION_API_URL=https://your-region-your-project.cloudfunctions.net/accountDeletion

# Firebase Web client configuration — public runtime configuration, not Admin secrets.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-logbook-site.web.app
VITE_FIREBASE_DATABASE_URL=your_database_url_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Firebase App Check — reCAPTCHA Enterprise public site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key_here

# Firebase Functions non-secret deployment parameters.
LOGBOOK_FUNCTION_REGION=europe-west1
LOGBOOK_ALLOWED_ORIGINS=https://your-logbook-site.web.app,https://your-legacy-logbook.vercel.app

# Legacy Vercel trusted runtime only during the migration window.
# Firebase Functions use Application Default Credentials and do not require an
# exported long-lived Admin key. Never prefix these legacy values with VITE_.
FIREBASE_ADMIN_PROJECT_ID=your_server_project_id_here
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_client_email_here
FIREBASE_ADMIN_PRIVATE_KEY="your_escaped_private_key_here"
CRON_SECRET=generate_a_long_random_secret_here

# Sentry client error monitoring — public DSN embedded in the production browser bundle.
VITE_SENTRY_DSN=your_sentry_public_dsn_here

# Sentry source-map upload — build-time only. SENTRY_AUTH_TOKEN is a secret.
SENTRY_AUTH_TOKEN=your_sentry_org_ci_token_here
SENTRY_ORG=your_sentry_org_slug_here
SENTRY_PROJECT=your_sentry_project_slug_here
